---
import { getImage } from 'astro:assets';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';

const TITLE = 'Where I have been with the A7';

// Same rules as the flat map: each folder in src/travel/ is a country you've visited.
const ALIASES = {
  usa: 'unitedstatesofamerica', us: 'unitedstatesofamerica', unitedstates: 'unitedstatesofamerica',
  uk: 'unitedkingdom', england: 'unitedkingdom', scotland: 'unitedkingdom',
  czechrepublic: 'czechia', bosnia: 'bosniaandherz', dominicanrepublic: 'dominicanrep',
  uae: 'unitedarabemirates', ivorycoast: 'ctedivoire', cotedivoire: 'ctedivoire', northmacedonia: 'macedonia',
};
const norm = (s) => s.toLowerCase().replace(/^\d+[-_ ]*/, '').replace(/[^a-z]/g, '');
const nice = (s) => s.replace(/\.[^.]+$/, '').replace(/^\d+[-_ ]*/, '').replace(/[-_]+/g, ' ').trim();

const countries = feature(world, world.objects.countries).features.filter((f) => f.id !== '010');

const files = import.meta.glob('../travel/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const entries = Object.entries(files).sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }));
const byFolder = new Map();
for (const [p, mod] of entries) {
  const parts = p.replace('../travel/', '').split('/');
  if (parts.length < 2) continue;
  const key = ALIASES[norm(parts[0])] || norm(parts[0]);
  if (!byFolder.has(key)) byFolder.set(key, []);
  byFolder.get(key).push({ src: mod.default, title: nice(parts[parts.length - 1]) });
}

const unmatched = [...byFolder.keys()].filter((k) => !countries.some((c) => norm(c.properties.name) === k));
const places = [];
for (let fi = 0; fi < countries.length; fi++) {
  const list = byFolder.get(norm(countries[fi].properties.name));
  if (!list) continue;
  const photos = await Promise.all(list.map(async (p) => {
    const t = await getImage({ src: p.src, width: 600, format: 'webp' });
    const f = await getImage({ src: p.src, width: 2200, format: 'webp' });
    return { t: p.title, th: t.src, f: f.src };
  }));
  places.push({ fi, name: countries[fi].properties.name, photos });
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{TITLE}</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Figtree:wght@400;500&display=swap" />
</head>
<body>
  <header>
    <a class="back" href="/">&larr; Gallery</a>
    <h1>{TITLE}</h1>
    <p class="sub">{places.length} {places.length === 1 ? 'country' : 'countries'}. Drag to spin, tap a glowing one for photos.</p>
  </header>

  <main>
    <div class="stage">
      <canvas id="globe" role="img" aria-label="Spinning 3D globe of countries visited"></canvas>
      <div class="ctl">
        <button id="spin" type="button" aria-pressed="true">Spin</button>
        <button id="zin" type="button" aria-label="Zoom in">+</button>
        <button id="zout" type="button" aria-label="Zoom out">&minus;</button>
      </div>
    </div>

    <section id="panel" hidden>
      <h2 id="pname"></h2>
      <div id="pgrid"></div>
    </section>
    {unmatched.length > 0 && <p class="warn">No match on the globe for folder: {unmatched.join(', ')}. Check the spelling.</p>}
  </main>

  <div id="lb" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button id="close" aria-label="Close">Close</button>
    <button class="nav" id="prev" aria-label="Previous">&lsaquo;</button>
    <img id="lbimg" alt="" />
    <p id="lbcap"></p>
    <button class="nav" id="next" aria-label="Next">&rsaquo;</button>
  </div>

  <script type="application/json" id="place-data" set:html={JSON.stringify(places)} />

  <script>
    import { feature } from 'topojson-client';
    import { geoOrthographic, geoPath, geoGraticule10, geoCentroid, geoContains } from 'd3-geo';
    import world from 'world-atlas/countries-110m.json';

    const places = JSON.parse(document.getElementById('place-data').textContent);
    const feats = feature(world, world.objects.countries).features.filter((f) => f.id !== '010');
    const visited = new Map(places.map((p, n) => [p.fi, n]));

    const canvas = document.getElementById('globe');
    const ctx = canvas.getContext('2d');
    const proj = geoOrthographic().clipAngle(90).precision(0.5);
    const path = geoPath(proj, ctx);
    const grat = geoGraticule10();
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let rot = [-100, -20], zoom = 1, size = 0, active = -1;
    let spinning = !reduce, dragging = false, moved = false, idleUntil = 0, tween = null;

    const resize = () => {
      const w = canvas.clientWidth || 600, dpr = window.devicePixelRatio || 1;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(w * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      size = w;
    };

    const draw = () => {
      proj.scale(size / 2 * 0.9 * zoom).translate([size / 2, size / 2]).rotate(rot);
      ctx.clearRect(0, 0, size, size);
      ctx.beginPath(); path({ type: 'Sphere' }); ctx.fillStyle = '#1f2427'; ctx.fill();
      ctx.beginPath(); path(grat); ctx.strokeStyle = 'rgba(255,255,255,.06)'; ctx.lineWidth = 0.6; ctx.stroke();
      feats.forEach((f, n) => {
        const on = visited.has(n);
        ctx.beginPath(); path(f);
        ctx.fillStyle = on ? (n === active ? '#c3e4dd' : '#8fc7bd') : '#3a4146';
        ctx.fill();
        ctx.strokeStyle = '#2a2f33'; ctx.lineWidth = 0.5; ctx.stroke();
      });
      ctx.beginPath(); path({ type: 'Sphere' }); ctx.strokeStyle = 'rgba(143,199,189,.35)'; ctx.lineWidth = 1.2; ctx.stroke();
    };

    let last = 0;
    const frame = (t) => {
      const dt = Math.min(50, t - last); last = t;
      if (tween) {
        const k = Math.min(1, (t - tween.t0) / tween.d), e = 1 - Math.pow(1 - k, 3);
        rot = [tween.a[0] + (tween.b[0] - tween.a[0]) * e, tween.a[1] + (tween.b[1] - tween.a[1]) * e];
        if (k >= 1) tween = null;
      } else if (spinning && !dragging && t > idleUntil && active < 0) {
        rot = [rot[0] + dt * 0.012, rot[1]];
      }
      draw();
      requestAnimationFrame(frame);
    };

    const flyTo = (f) => {
      const c = geoCentroid(f);
      const a = rot.slice();
      const b0 = -c[0];
      const b = [a[0] + ((b0 - a[0] + 540) % 360) - 180, Math.max(-60, Math.min(60, -c[1]))];
      tween = { a, b, t0: performance.now(), d: 900 };
    };

    // photo panel + viewer
    const panel = document.getElementById('panel');
    const grid = document.getElementById('pgrid');
    const lb = document.getElementById('lb');
    const img = document.getElementById('lbimg');
    const cap = document.getElementById('lbcap');
    let p = 0, i = 0;
    const show = () => { const ph = places[p].photos[i]; img.src = ph.f; img.alt = ph.t; cap.textContent = ph.t + '  (' + (i + 1) + '/' + places[p].photos.length + ')'; };
    const step = (d) => { const n = places[p].photos.length; i = (i + d + n) % n; show(); };
    const close = () => lb.classList.remove('on');

    const openPlace = (n) => {
      p = n; active = places[n].fi;
      document.getElementById('pname').textContent = places[n].name;
      grid.innerHTML = '';
      places[n].photos.forEach((ph, k) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'ph'; b.setAttribute('aria-label', 'Open ' + ph.t);
        const im = document.createElement('img'); im.src = ph.th; im.alt = ph.t; im.loading = 'lazy';
        b.appendChild(im);
        b.onclick = () => { i = k; show(); lb.classList.add('on'); document.getElementById('close').focus(); };
        grid.appendChild(b);
      });
      panel.hidden = false;
      flyTo(feats[active]);
      setTimeout(() => panel.scrollIntoView({ behavior: 'smooth', block: 'start' }), 950);
    };

    // drag, pinch, tap
    const ptrs = new Map();
    let sx = 0, sy = 0, prevDist = 0;
    const dist = () => { const a = [...ptrs.values()]; return a.length < 2 ? 0 : Math.hypot(a[0].x - a[1].x, a[0].y - a[1].y); };
    canvas.addEventListener('pointerdown', (e) => {
      ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (ptrs.size === 1) { sx = e.clientX; sy = e.clientY; moved = false; dragging = true; tween = null; }
      if (ptrs.size === 2) { prevDist = dist(); moved = true; }
    });
    window.addEventListener('pointermove', (e) => {
      if (!ptrs.has(e.pointerId)) return;
      const old = ptrs.get(e.pointerId);
      ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (ptrs.size === 1) {
        if (!moved && Math.hypot(e.clientX - sx, e.clientY - sy) > 6) moved = true;
        if (moved) {
          const k = 0.4 / zoom;
          rot = [rot[0] + (e.clientX - old.x) * k, Math.max(-85, Math.min(85, rot[1] - (e.clientY - old.y) * k))];
        }
      } else if (ptrs.size === 2) {
        const d = dist();
        if (prevDist) zoom = Math.max(0.7, Math.min(3, zoom * d / prevDist));
        prevDist = d;
      }
    });
    const endPtr = (e) => {
      if (!ptrs.has(e.pointerId)) return;
      const wasOne = ptrs.size === 1;
      ptrs.delete(e.pointerId); prevDist = 0;
      if (ptrs.size === 0) { dragging = false; idleUntil = performance.now() + 2500; }
      if (wasOne && !moved && e.type === 'pointerup') {
        const r = canvas.getBoundingClientRect();
        const pt = proj.invert([(e.clientX - r.left) * size / r.width, (e.clientY - r.top) * size / r.height]);
        if (pt) {
          const n = feats.findIndex((f) => geoContains(f, pt));
          if (n >= 0 && visited.has(n)) openPlace(visited.get(n));
        }
      }
    };
    window.addEventListener('pointerup', endPtr);
    window.addEventListener('pointercancel', endPtr);
    canvas.addEventListener('wheel', (e) => { e.preventDefault(); zoom = Math.max(0.7, Math.min(3, zoom * Math.exp(-e.deltaY * 0.0012))); }, { passive: false });

    const spinBtn = document.getElementById('spin');
    spinBtn.setAttribute('aria-pressed', String(spinning));
    spinBtn.onclick = () => { spinning = !spinning; active = spinning ? -1 : active; spinBtn.setAttribute('aria-pressed', String(spinning)); };
    document.getElementById('zin').onclick = () => { zoom = Math.min(3, zoom * 1.3); };
    document.getElementById('zout').onclick = () => { zoom = Math.max(0.7, zoom / 1.3); };

    document.getElementById('close').onclick = close;
    document.getElementById('prev').onclick = () => step(-1);
    document.getElementById('next').onclick = () => step(1);
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('on')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });

    window.addEventListener('resize', resize);
    resize();
    requestAnimationFrame(frame);
  </script>

  <style is:global>
    :root{--bg:#2a2f33;--surface:#343a3f;--text:#e9e9e6;--muted:#9aa2a8;--accent:#8fc7bd;--line:#454d54}
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--text);font:400 16px/1.5 Figtree,system-ui,sans-serif}
    header{padding:40px 24px 16px;max-width:1200px;margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center}
    .back{color:var(--muted);text-decoration:none;font-size:14px;padding:6px 16px;border:1px solid var(--line);border-radius:999px}
    .back:hover{color:var(--accent);border-color:var(--accent)}
    h1{font:italic 400 clamp(32px,7vw,60px)/1.05 Newsreader,Georgia,serif;margin:8px 0 0;letter-spacing:-.02em}
    .sub{color:var(--muted);margin:8px auto 0}
    main{max-width:1000px;margin:0 auto;padding:0 24px 80px}
    .stage{position:relative;max-width:720px;margin:0 auto}
    #globe{display:block;width:100%;aspect-ratio:1;touch-action:none;cursor:grab;user-select:none;-webkit-user-select:none}
    #globe:active{cursor:grabbing}
    .ctl{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:6px}
    .flat{color:var(--muted);text-decoration:none;font:500 14px Figtree,sans-serif;padding:8px 16px;border:1px solid var(--line);border-radius:999px}
    .flat:hover{color:var(--accent);border-color:var(--accent)}
    button{font:500 14px Figtree,sans-serif;color:var(--text);background:transparent;border:1px solid var(--line);border-radius:999px;padding:8px 16px;cursor:pointer;min-width:44px}
    button:hover{border-color:var(--accent)}
    button[aria-pressed="true"]{background:var(--accent);color:#0c1517;border-color:var(--accent)}
    button:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
    #panel{margin-top:32px;scroll-margin-top:16px}
    #panel h2{font:italic 400 30px/1.2 Newsreader,Georgia,serif;margin:0 0 14px}
    #pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px}
    .ph{padding:0;border:0;border-radius:3px;overflow:hidden;background:var(--surface);cursor:zoom-in;aspect-ratio:4/3;min-width:0}
    .ph img{display:block;width:100%;height:100%;object-fit:cover}
    .warn{color:#e8c07a;font-size:14px;margin-top:20px}
    #lb{position:fixed;inset:0;background:rgba(30,34,37,.97);display:none;flex-direction:column;align-items:center;justify-content:center;padding:24px;z-index:10}
    #lb.on{display:flex}
    #lb img{max-width:100%;max-height:82vh;border-radius:2px}
    #lb p{font:italic 400 22px Newsreader,serif;margin:16px 0 0;text-align:center}
    .nav{position:absolute;top:50%;transform:translateY(-50%);font-size:22px;width:44px;height:44px;padding:0}
    #prev{left:12px}#next{right:12px}#close{position:absolute;top:14px;right:14px}
    @media (max-width:600px){main{padding:0 12px 60px}#pgrid{grid-template-columns:repeat(2,1fr)}}
  </style>
</body>
</html>
