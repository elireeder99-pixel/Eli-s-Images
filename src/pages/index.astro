---
import { getImage } from 'astro:assets';

const TITLE = 'EREED MEDIA';
const SUBTITLE = 'Worldwide.';
const FEATURE_EVERY = 7; // every Nth photo becomes a big tile

// Every image in src/photos shows up automatically, in filename order.
// Put a number at the start of a filename (01-, 02-) to control the order.
const files = import.meta.glob('../photos/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const nice = (s) => s.replace(/\.[^.]+$/, '').replace(/^\d+[-_ ]*/, '').replace(/[-_]+/g, ' ').trim();
const entries = Object.entries(files).sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }));

const photos = await Promise.all(entries.map(async ([path, mod], i) => {
  const thumb = await getImage({ src: mod.default, width: 1100, format: 'webp' });
  const full = await getImage({ src: mod.default, width: 2200, format: 'webp' });
  const ratio = thumb.attributes.width / thumb.attributes.height;
  // Tile shape: every 7th photo is a big feature tile, wide photos get wide tiles, tall photos get tall tiles.
  let cw = 1, rh = 1;
  if (i % FEATURE_EVERY === 0) { cw = 2; rh = 2; }
  else if (ratio >= 1.4) { cw = 2; }
  else if (ratio <= 0.8) { rh = 2; }
  return { title: nice(path.split('/').pop()), thumb: thumb.src, full: full.src, cw, rh };
}));
const data = photos.map((p) => ({ t: p.title, f: p.full }));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{TITLE}</title>
  <meta name="description" content={SUBTITLE} />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Figtree:wght@400;500&display=swap" />
</head>
<body>
  <header>
    <h1>{TITLE}</h1>
    <p class="sub">{SUBTITLE}</p>
    <figure class="quote">
      <blockquote id="q">The best camera is the one that's with you.</blockquote>
      <figcaption id="qa">Chase Jarvis</figcaption>
    </figure>
    <a class="mapbtn" href="/globe">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>
  Globe
</a>

  </header>

  <main>
    <div class="puzzle">
      {photos.map((p, i) => (
        <button class="ph" type="button" data-i={i} style={`grid-column:span ${p.cw};grid-row:span ${p.rh}`} aria-label={`Open ${p.title}`}>
          <img src={p.thumb} alt={p.title} loading="lazy" decoding="async" />
          <span>{p.title}</span>
        </button>
      ))}
    </div>
  </main>

  <div id="lb" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button id="close" aria-label="Close">Close</button>
    <button class="nav" id="prev" aria-label="Previous">&lsaquo;</button>
    <img id="lbimg" alt="" />
    <p id="lbcap"></p>
    <button class="nav" id="next" aria-label="Next">&rsaquo;</button>
  </div>

  <script type="application/json" id="photo-data" set:html={JSON.stringify(data)} />

  <script>
    const list = JSON.parse(document.getElementById('photo-data').textContent);
    const lb = document.getElementById('lb');
    const img = document.getElementById('lbimg');
    const cap = document.getElementById('lbcap');
    let i = 0;

    const show = () => {
      const p = list[i];
      img.src = p.f; img.alt = p.t;
      cap.textContent = p.t + '  (' + (i + 1) + '/' + list.length + ')';
    };
    const step = (d) => { i = (i + d + list.length) % list.length; show(); };
    const close = () => lb.classList.remove('on');

    document.querySelectorAll('.ph').forEach((el) => el.addEventListener('click', () => {
      i = Number(el.dataset.i); show();
      lb.classList.add('on'); document.getElementById('close').focus();
    }));
    document.getElementById('close').onclick = close;
    document.getElementById('prev').onclick = () => step(-1);
    document.getElementById('next').onclick = () => step(1);
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('on')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
  </script>

  <script>
    const QUOTES = [
      ["The best camera is the one that's with you.", "Chase Jarvis"],
      ["You don't take a photograph, you make it.", "Ansel Adams"],
      ["A good photograph is knowing where to stand.", "Ansel Adams"],
      ["Your first 10,000 photographs are your worst.", "Henri Cartier-Bresson"],
      ["Light makes photography. Embrace light.", "George Eastman"],
      ["Photography is the story I fail to put into words.", "Destin Sparks"],
      ["Life is either a daring adventure or nothing at all.", "Helen Keller"],
      ["The only way to do great work is to love what you do.", "Steve Jobs"],
      ["Not all those who wander are lost.", "J.R.R. Tolkien"],
      ["A journey of a thousand miles begins with a single step.", "Lao Tzu"],
      ["Well done is better than well said.", "Benjamin Franklin"],
      ["The unexamined life is not worth living.", "Socrates"],
      ["Fall seven times, stand up eight.", "Japanese proverb"],
      ["The best time to plant a tree was twenty years ago. The second best time is now.", "Proverb"],
    ];
    const q = document.getElementById('q');
    const qa = document.getElementById('qa');
    const SLOT = 5 * 60 * 1000;
    const show = (i) => { q.textContent = QUOTES[i][0]; qa.textContent = QUOTES[i][1]; };
    const hash = (n) => { n = Math.imul(n ^ (n >>> 15), 2246822507); n = Math.imul(n ^ (n >>> 13), 3266489909); return (n ^ (n >>> 16)) >>> 0; };
    const pick = (slot) => {
      const i = hash(slot) % QUOTES.length;
      return i === hash(slot - 1) % QUOTES.length ? (i + 1) % QUOTES.length : i;
    };
    let slot = Math.floor(Date.now() / SLOT);
    show(pick(slot));
    setInterval(() => {
      const now = Math.floor(Date.now() / SLOT);
      if (now !== slot) { slot = now; show(pick(now)); }
    }, 30000);
  </script>

  <style is:global>
    :root{--bg:#2a2f33;--surface:#343a3f;--text:#e9e9e6;--muted:#9aa2a8;--accent:#8fc7bd;--line:#454d54}
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--text);font:400 16px/1.5 Figtree,system-ui,sans-serif}
    header{padding:56px 24px 28px;max-width:1200px;margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center}
    h1{font:italic 400 clamp(34px,7vw,72px)/1 Newsreader,Georgia,serif;margin:0;letter-spacing:-.02em}
    .sub{color:var(--muted);margin:10px auto 0;max-width:44ch}
    .quote{margin:22px auto 0;max-width:52ch}
    .quote blockquote{margin:0;font:italic 400 clamp(18px,3vw,24px)/1.4 Newsreader,Georgia,serif}
    .quote figcaption{color:var(--muted);font-size:14px;margin-top:8px}
    .mapbtn{display:inline-flex;align-items:center;gap:8px;margin-top:16px;padding:10px 20px;border:1px solid var(--accent);border-radius:999px;color:var(--accent);text-decoration:none;font:500 15px Figtree,sans-serif;transition:background .15s,color .15s}
    .mapbtn:hover,.mapbtn:focus-visible{background:var(--accent);color:#0c1517}

    button{font:500 14px Figtree,sans-serif;color:var(--text);background:transparent;border:1px solid var(--line);border-radius:999px;padding:8px 16px;cursor:pointer}
    button:hover{border-color:var(--accent)}
    button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
    main{max-width:1400px;margin:0 auto;padding:0 12px 80px;container-type:inline-size}
    .puzzle{--cols:6;--gap:6px;display:grid;grid-template-columns:repeat(var(--cols),minmax(0,1fr));grid-auto-rows:calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols));grid-auto-flow:dense;gap:var(--gap)}
    .ph{position:relative;display:block;width:100%;height:100%;padding:0;border:0;border-radius:2px;overflow:hidden;background:var(--surface);cursor:zoom-in}
    .ph img{display:block;width:100%;height:100%;object-fit:cover}
    .ph span{position:absolute;left:0;right:0;bottom:0;padding:28px 14px 12px;font:italic 400 17px Newsreader,serif;text-align:left;background:linear-gradient(transparent,rgba(30,34,37,.85));opacity:0;transition:opacity .2s;color:#fff}
    .ph:hover span,.ph:focus-visible span{opacity:1}
    #lb{position:fixed;inset:0;background:rgba(30,34,37,.97);display:none;flex-direction:column;align-items:center;justify-content:center;padding:24px;z-index:10}
    #lb.on{display:flex}
    #lb img{max-width:100%;max-height:82vh;border-radius:2px}
    #lb p{font:italic 400 22px Newsreader,serif;margin:16px 0 0;text-align:center}
    .nav{position:absolute;top:50%;transform:translateY(-50%);font-size:22px;width:44px;height:44px;padding:0}
    #prev{left:12px}#next{right:12px}#close{position:absolute;top:14px;right:14px}
    @media (max-width:700px){.puzzle{--cols:4;--gap:4px}main{padding:0 6px 60px}}
    @media (prefers-reduced-motion:reduce){.ph span{transition:none}}
  </style>
</body>
</html>
