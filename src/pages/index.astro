---
import { getImage } from 'astro:assets';

const TITLE = 'Eli Reeder Photography';
const SUBTITLE = 'A small collection of favourites.';
const PER_ROW = 3;

const files = import.meta.glob('../photos/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const nice = (s) => s.replace(/\.[^.]+$/, '').replace(/^\d+[-_ ]*/, '').replace(/[-_]+/g, ' ').trim();
const entries = Object.entries(files).sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }));

const byAlbum = new Map();
for (const [path, mod] of entries) {
  const parts = path.replace('../photos/', '').split('/');
  const key = parts.length > 1 ? parts[0] : '';
  if (!byAlbum.has(key)) byAlbum.set(key, []);
  byAlbum.get(key).push({ src: mod.default, title: nice(parts[parts.length - 1]) });
}

const albums = await Promise.all([...byAlbum.entries()].map(async ([key, list]) => ({
  name: key ? nice(key) : 'Gallery',
  photos: await Promise.all(list.map(async (p, i) => {
    const full = await getImage({ src: p.src, width: 2200, format: 'webp' });
    const thumb = i < PER_ROW ? await getImage({ src: p.src, width: 900, format: 'webp' }) : null;
    return {
      title: p.title,
      full: full.src,
      thumb: thumb ? thumb.src : '',
      ratio: thumb ? thumb.attributes.width / thumb.attributes.height : 1,
    };
  })),
})));
const data = albums.map((a) => ({ name: a.name, photos: a.photos.map((p) => ({ t: p.title, f: p.full })) }));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{TITLE}</title>
  <meta name="description" content={SUBTITLE} />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Figtree:wght@400;500&display=swap" />
</head>
<body>
  <header>
    <h1>{TITLE}</h1>
    <p class="sub">{SUBTITLE}</p>
    <figure class="quote">
      <blockquote id="q">The best camera is the one that's with you.</blockquote>
      <figcaption id="qa">Chase Jarvis</figcaption>
    </figure>
  </header>

  <main>
    {albums.map((a, ai) => (
      <section class="album">
        <h2>{a.name}</h2>
        <div class="row">
          {a.photos.slice(0, PER_ROW).map((p, i) => (
            <button class="ph" type="button" data-a={ai} data-i={i} style={`flex:${p.ratio} 1 0%`} aria-label={`Open ${p.title}`}>
              <img src={p.thumb} alt={p.title} loading="lazy" decoding="async" />
              <span>{p.title}</span>
              {i === PER_ROW - 1 && a.photos.length > PER_ROW && <em class="more">+{a.photos.length - PER_ROW} more</em>}
            </button>
          ))}
        </div>
      </section>
    ))}
  </main>

  <div id="lb" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button id="close" aria-label="Close">Close</button>
    <button class="nav" id="prev" aria-label="Previous">&lsaquo;</button>
    <img id="lbimg" alt="" />
    <p id="lbcap"></p>
    <button class="nav" id="next" aria-label="Next">&rsaquo;</button>
  </div>

  <script type="application/json" id="album-data" set:html={JSON.stringify(data)} />

  <script>
    const albums = JSON.parse(document.getElementById('album-data').textContent);
    const lb = document.getElementById('lb');
    const img = document.getElementById('lbimg');
    const cap = document.getElementById('lbcap');
    let a = 0, i = 0;

    const show = () => {
      const list = albums[a].photos;
      const p = list[i];
      img.src = p.f; img.alt = p.t;
      cap.textContent = p.t + '  (' + (i + 1) + '/' + list.length + ')';
    };
    const step = (d) => { const n = albums[a].photos.length; i = (i + d + n) % n; show(); };
    const close = () => lb.classList.remove('on');

    document.querySelectorAll('.ph').forEach((el) => el.addEventListener('click', () => {
      a = Number(el.dataset.a); i = Number(el.dataset.i); show();
      lb.classList.add('on'); document.getElementById('close').focus();
    }));
    document.getElementById('close').onclick = close;
    document.getElementById('prev').onclick = () => step(-1);
    document.getElementById('next').onclick = () => step(1);
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('on')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
  </script>

